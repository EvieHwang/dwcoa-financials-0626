# DWCOA Financials — backend configuration.
# Copy to .env and fill in real values locally; never commit a populated .env.
# Authoritative source of values is the 1Password "Eviebot" vault.

# bcrypt hash of the treasurer (admin) shared password.
ADMIN_PASSWORD_HASH=
# bcrypt hash of the board (view-only) shared password.
BOARD_PASSWORD_HASH=
# JWT (HS256) signing key for session tokens.
SESSION_SECRET=
# SQLite database file path (defaults to the mounted Fly volume in production).
DATABASE_PATH=

# Optional — built-frontend directory (defaults to backend/static).
# STATIC_DIR=
# Optional — login rate-limit tuning.
# LOGIN_MAX_ATTEMPTS=
# LOGIN_WINDOW_SECONDS=
# Optional — max CSV upload size in bytes (defaults to 5,000,000; a multi-year
# bank history is well under 1 MB).
# INGEST_MAX_UPLOAD_BYTES=

# CI/deploy secret (not read by the app at runtime): Fly deploy token.
# FLY_API_TOKEN=
